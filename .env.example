GEMINI_API_KEY=
# Supabase Dashboard > Connect > Session pooler (port 5432) URI
# 비밀번호의 특수문자는 URL 인코딩해서 입력하세요.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[URL-ENCODED-PASSWORD]@aws-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
# 운영은 database, 외부 DB 없이 테스트할 때만 memory를 사용합니다.
SESSION_STORAGE=database
