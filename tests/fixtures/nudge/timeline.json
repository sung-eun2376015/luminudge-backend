[
  {
    "start": 0,
    "end": 4,
    "text": "안녕 친구들! 오늘은 동물 친구들을 만나러 숲으로 가요."
  },
  {
    "start": 4,
    "end": 8,
    "text": "먼저 귀가 긴 토끼가 나왔어요."
  },
  {
    "start": 8,
    "end": 12,
    "text": "토끼가 깡충깡충 뛰고 있어요."
  },
  {
    "start": 12,
    "end": 16,
    "text": "우리도 토끼처럼 깡충 뛰어볼까요?"
  },
  {
    "start": 16,
    "end": 20,
    "text": "우와!"
  },
  {
    "start": 20,
    "end": 24,
    "text": "다음에는 무엇이 나올까요?"
  },
  {
    "start": 24,
    "end": 28,
    "text": "이번에는 파란 새가 날아왔어요."
  },
  {
    "start": 28,
    "end": 32,
    "text": "새가 하늘 위로 훨훨 날고 있어요."
  },
  {
    "start": 32,
    "end": 36,
    "text": "파란색 날개를 찾아볼까요?"
  },
  {
    "start": 36,
    "end": 40,
    "text": "멋지다!"
  },
  {
    "start": 40,
    "end": 44,
    "text": "이제 숫자를 같이 세어볼 거예요."
  },
  {
    "start": 44,
    "end": 48,
    "text": "하나, 둘, 셋!"
  },
  {
    "start": 48,
    "end": 52,
    "text": "사과가 세 개 있어요."
  },
  {
    "start": 52,
    "end": 56,
    "text": "빨간 사과를 찾아볼까요?"
  },
  {
    "start": 56,
    "end": 60,
    "text": "정말 잘했어요!"
  },
  {
    "start": 60,
    "end": 64,
    "text": "와!"
  },
  {
    "start": 64,
    "end": 68,
    "text": "좋아요!"
  },
  {
    "start": 68,
    "end": 72,
    "text": "다음에는 무엇이 나올까요?"
  }
]